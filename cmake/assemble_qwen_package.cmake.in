cmake_minimum_required(VERSION 3.25)
set(package "@QWEN_PACKAGE_DIRECTORY@")
set(source "@CMAKE_CURRENT_SOURCE_DIR@")
set(runtime_search_dirs "@qwen_runtime_search_dirs@")
set(compiler_runtimes "@qwen_compiler_runtime_files@")
set(debug_compiler_runtimes "@qwen_debug_runtime_files@")
set(qt_notices "@qwen_qt_notice_inputs@")
set(executables
    "$<TARGET_FILE:qwen_adapter>" "$<TARGET_FILE:qwen_helper>"
    "$<TARGET_FILE:qwen_launch_bridge>")
set(CMAKE_GET_RUNTIME_DEPENDENCIES_PLATFORM "@CMAKE_GET_RUNTIME_DEPENDENCIES_PLATFORM@")
set(CMAKE_GET_RUNTIME_DEPENDENCIES_TOOL "@CMAKE_GET_RUNTIME_DEPENDENCIES_TOOL@")
set(CMAKE_GET_RUNTIME_DEPENDENCIES_COMMAND "@CMAKE_GET_RUNTIME_DEPENDENCIES_COMMAND@")
# These variables may be unset until install code is generated. Use the actual
# selected toolchain, never a dumpbin/objdump from another installation on PATH.
if("@CMAKE_SYSTEM_NAME@" STREQUAL "Windows")
    set(CMAKE_GET_RUNTIME_DEPENDENCIES_PLATFORM windows+pe)
    if("@MSVC@")
        set(CMAKE_GET_RUNTIME_DEPENDENCIES_TOOL dumpbin)
        get_filename_component(compiler_dir "@CMAKE_CXX_COMPILER@" DIRECTORY)
        set(CMAKE_GET_RUNTIME_DEPENDENCIES_COMMAND "${compiler_dir}/dumpbin.exe")
    else()
        set(CMAKE_GET_RUNTIME_DEPENDENCIES_TOOL objdump)
        set(CMAKE_GET_RUNTIME_DEPENDENCIES_COMMAND "@CMAKE_OBJDUMP@")
    endif()
    set(exclusions PRE_EXCLUDE_REGEXES "^[Aa][Pp][Ii]-" "^[Ee][Xx][Tt]-"
        POST_INCLUDE_REGEXES ".*/[Mm][Ss][Vv][Cc][Pp][0-9].*" ".*/[Vv][Cc][Rr][Uu][Nn][Tt][Ii][Mm][Ee].*"
            ".*/[Cc][Oo][Nn][Cc][Rr][Tt][0-9].*" ".*/[Vv][Cc][Cc][Oo][Rr][Ll][Ii][Bb][0-9].*"
            ".*/[Uu][Cc][Rr][Tt][Bb][Aa][Ss][Ee][Dd]\\.[Dd][Ll][Ll]$"
        POST_EXCLUDE_REGEXES ".*[/\\\\][Ww][Ii][Nn][Dd][Oo][Ww][Ss][/\\\\].*")
elseif("@CMAKE_SYSTEM_NAME@" STREQUAL "Darwin")
    set(CMAKE_GET_RUNTIME_DEPENDENCIES_PLATFORM macos+macho)
    set(CMAKE_GET_RUNTIME_DEPENDENCIES_TOOL otool)
    set(CMAKE_GET_RUNTIME_DEPENDENCIES_COMMAND /usr/bin/otool)
    # Apple's shared cache supplies these libraries even when no corresponding
    # filesystem entry exists. Every other dependency must be packaged.
    set(exclusions PRE_EXCLUDE_REGEXES "^/System/Library/" "^/usr/lib/")
else()
    set(CMAKE_GET_RUNTIME_DEPENDENCIES_PLATFORM linux+elf)
    set(CMAKE_GET_RUNTIME_DEPENDENCIES_TOOL objdump)
    set(CMAKE_GET_RUNTIME_DEPENDENCIES_COMMAND "@CMAKE_OBJDUMP@")
    # glibc and the ELF loader belong to the supported OS, including their
    # internal ABI coupling. Compiler, ICU, compression, and other libraries
    # remain in the resolved closure even when installed under /usr/lib.
    set(exclusions PRE_EXCLUDE_REGEXES
        "^ld-linux.*" "^linux-vdso.*" "^lib(c|m|dl|rt|pthread|resolv|util|anl)\\.so\\..*")
endif()

set(qwen_runtime_dependency_cache_directory "@CMAKE_CURRENT_BINARY_DIR@/runtime-dependencies-$<CONFIG>")
include("${source}/cmake/qwen_runtime_dependencies.cmake")

set(inputs "${CMAKE_CURRENT_LIST_FILE}")
list(APPEND inputs "${source}/cmake/qwen_runtime_dependencies.cmake")
set(copies "")
set(runtime_resources "")
set(runtime_notices "")
set(runtime_provenance "")
set(executable_relatives "")
foreach(executable IN LISTS executables)
    get_filename_component(name "${executable}" NAME)
    # One executable directory lets Windows load the same app-local DLLs for
    # the adapter, native hook helper and launch bridge.
    list(APPEND executable_relatives "adapter/${name}")
    list(APPEND copies "${executable}|adapter/${name}")
    qwen_resolve_runtime_dependencies(resolved EXECUTABLES "${executable}")
    set(pending_runtimes "${resolved}")
    set(visited_runtimes "")
    while(pending_runtimes)
        list(POP_FRONT pending_runtimes runtime)
        set(resolved_runtime "${runtime}")
        get_filename_component(runtime_name "${runtime}" NAME)
        # Windows may resolve a redistributable in System32 first. Ship the
        # matching compiler's redistributable, not a machine servicing artifact.
        set(is_compiler_runtime FALSE)
        set(is_debug_compiler_runtime FALSE)
        foreach(compiler_runtime IN LISTS compiler_runtimes debug_compiler_runtimes)
            get_filename_component(compiler_name "${compiler_runtime}" NAME)
            string(TOLOWER "${runtime_name}" runtime_lower)
            string(TOLOWER "${compiler_name}" compiler_lower)
            if(runtime_lower STREQUAL compiler_lower)
                set(runtime "${compiler_runtime}")
                set(runtime_name "${compiler_name}")
                set(is_compiler_runtime TRUE)
                if(compiler_runtime IN_LIST debug_compiler_runtimes)
                    set(is_debug_compiler_runtime TRUE)
                endif()
                break()
            endif()
        endforeach()
        if(runtime IN_LIST visited_runtimes)
            continue()
        endif()
        list(APPEND visited_runtimes "${runtime}")
        if(NOT runtime STREQUAL resolved_runtime)
            # The toolchain DLL can differ from the system copy. Resolve its
            # own imports too; the system DLL's closure does not prove those.
            qwen_resolve_runtime_dependencies(extra LIBRARIES "${runtime}")
            list(APPEND pending_runtimes ${extra})
        endif()
        if("@CMAKE_SYSTEM_NAME@" STREQUAL "Darwin")
            set(relative "helpers/runtime/${runtime_name}")
        else()
            set(relative "adapter/${runtime_name}")
        endif()
        string(SHA256 resource_key "${relative}")
        file(SHA256 "${runtime}" runtime_digest)
        if(DEFINED runtime_copy_${resource_key} AND
           NOT runtime_copy_${resource_key} STREQUAL runtime_digest)
            message(FATAL_ERROR "Executables require conflicting runtime bytes at ${relative}")
        endif()
        set(runtime_copy_${resource_key} "${runtime_digest}")
        list(APPEND copies "${runtime}|${relative}")
        list(APPEND runtime_resources "${relative}")
        string(APPEND runtime_provenance "${relative} <- ${runtime}\n")
        if(is_debug_compiler_runtime)
            string(APPEND runtime_provenance "  Microsoft Debug runtime: private debugging/testing deployment only.\n")
        endif()
        if(runtime_name MATCHES "^(lib)?Qt6Core" OR
           ("@CMAKE_SYSTEM_NAME@" STREQUAL "Darwin" AND runtime_name STREQUAL "QtCore"))
            continue()
        endif()
        set(notice "@QWEN_RUNTIME_NOTICES_DIRECTORY@/${runtime_name}.txt")
        if(is_debug_compiler_runtime)
            set(notice "${source}/package/notices/msvc-debug-runtime.txt")
        elseif(is_compiler_runtime)
            set(notice "${source}/package/notices/msvc-runtime.txt")
        elseif(NOT EXISTS "${notice}" AND "@CMAKE_SYSTEM_NAME@" STREQUAL "Linux")
            # Debian-family installations carry the exact installed package's
            # copyright and license text. Other distributions use the explicit
            # notice-directory input instead of shipping guessed notices.
            file(REAL_PATH "${runtime}" real_runtime)
            string(REGEX REPLACE "^/usr/" "/" merged_usr_runtime "${real_runtime}")
            foreach(candidate "${runtime}" "${real_runtime}" "${merged_usr_runtime}")
                execute_process(COMMAND dpkg-query -S "${candidate}"
                    RESULT_VARIABLE result OUTPUT_VARIABLE owner ERROR_QUIET)
                if(result EQUAL 0 AND owner MATCHES "^([^:\n]+)(:[^: \n]+)?: ")
                    set(notice "/usr/share/doc/${CMAKE_MATCH_1}/copyright")
                    if(EXISTS "${notice}")
                        break()
                    endif()
                endif()
            endforeach()
        endif()
        if(NOT EXISTS "${notice}")
            message(FATAL_ERROR "Missing notice for ${runtime}; provide @QWEN_RUNTIME_NOTICES_DIRECTORY@/${runtime_name}.txt through QWEN_RUNTIME_NOTICES_DIRECTORY")
        endif()
        list(APPEND runtime_notices "${notice}")
    endwhile()
endforeach()
list(REMOVE_DUPLICATES copies)
list(REMOVE_DUPLICATES runtime_resources)
list(REMOVE_DUPLICATES runtime_notices)
list(SORT copies)
list(SORT runtime_resources)
list(SORT runtime_notices)

file(GLOB_RECURSE resources LIST_DIRECTORIES FALSE
    "${source}/package/assets/*" "${source}/package/capabilities/*"
    "${source}/package/notices/*" "${source}/package/provenance/*")
foreach(resource IN LISTS resources)
    file(RELATIVE_PATH relative "${source}/package" "${resource}")
    list(APPEND copies "${resource}|${relative}")
endforeach()
list(APPEND copies
    "@CMAKE_CURRENT_BINARY_DIR@/generated/logonomic-cli-addon.json|logonomic-cli-addon.json")
set(notice_inputs ${qt_notices} ${runtime_notices})
list(APPEND inputs ${notice_inputs})
set(signature "${copies}\n${runtime_provenance}\n${notice_inputs}\n")
foreach(copy IN LISTS copies)
    string(REPLACE "|" ";" pair "${copy}")
    list(GET pair 0 input)
    list(APPEND inputs "${input}")
endforeach()
list(APPEND inputs "$<TARGET_FILE:logonomic_cli_addon_index>")
set(index_dependencies [==[@qwen_index_dependencies@]==])
list(APPEND inputs ${index_dependencies})
if("@CMAKE_SYSTEM_NAME@" STREQUAL "Linux")
    list(APPEND inputs "@QWEN_PATCHELF_EXECUTABLE@" "@QWEN_LINUX_RUNTIME_DEPLOYER@" "@Python3_EXECUTABLE@")
    if(NOT "@QWEN_LINUX_RUNTIME_MATERIAL@" STREQUAL "")
        list(APPEND inputs "@QWEN_LINUX_RUNTIME_MATERIAL@")
    endif()
elseif("@CMAKE_SYSTEM_NAME@" STREQUAL "Darwin")
    list(APPEND inputs "@QWEN_MACOS_RUNTIME_DEPLOYER@" "@Python3_EXECUTABLE@")
endif()
foreach(input IN LISTS inputs)
    file(SHA256 "${input}" digest)
    string(APPEND signature "${input} ${digest}\n")
endforeach()
string(SHA256 signature "${signature}")
set(receipt "@CMAKE_CURRENT_BINARY_DIR@/package-inputs-$<CONFIG>.sha256")

function(qwen_package_content_signature output)
    file(GLOB_RECURSE paths LIST_DIRECTORIES TRUE RELATIVE "${package}" "${package}/*")
    set(content "")
    foreach(path IN LISTS paths)
        if(IS_SYMLINK "${package}/${path}")
            set(${output} "" PARENT_SCOPE)
            return()
        endif()
        if(NOT IS_DIRECTORY "${package}/${path}")
            file(SHA256 "${package}/${path}" digest)
            string(APPEND content "${path} ${digest}\n")
        endif()
    endforeach()
    string(SHA256 digest "${content}")
    set(${output} "${digest}" PARENT_SCOPE)
endfunction()

if(EXISTS "${receipt}" AND EXISTS "${package}/package.files.json")
    file(READ "${receipt}" previous)
    qwen_package_content_signature(package_signature)
    if(package_signature AND previous STREQUAL "${signature}\n${package_signature}\n")
        return()
    endif()
endif()

set(notice_text "Runtime components incorporated in this package\n\n${runtime_provenance}\n")
foreach(notice IN LISTS notice_inputs)
    file(READ "${notice}" content)
    string(APPEND notice_text "\n--- ${notice} ---\n${content}\n")
endforeach()

# package is the SDK-selected build output, never an installed generation.
file(REMOVE_RECURSE "${package}")
set(linux_arguments record --package "${package}" --configuration "$<CONFIG>")
set(linux_recorded_members "")
foreach(copy IN LISTS copies)
    string(REPLACE "|" ";" pair "${copy}")
    list(GET pair 0 input)
    list(GET pair 1 relative)
    get_filename_component(destination "${package}/${relative}" DIRECTORY)
    file(MAKE_DIRECTORY "${destination}")
    # Dereference SONAME symlinks: the SDK deliberately admits regular files only.
    file(REAL_PATH "${input}" real_input)
    if("@CMAKE_SYSTEM_NAME@" STREQUAL "Linux" AND relative MATCHES "^(adapter|helpers)/" AND
       NOT relative IN_LIST linux_recorded_members)
        file(SHA256 "${real_input}" input_digest)
        list(APPEND linux_arguments --input "${real_input}" "${relative}" "${input_digest}")
        list(APPEND linux_recorded_members "${relative}")
    endif()
    file(COPY_FILE "${real_input}" "${package}/${relative}")
    if(relative MATCHES "^(adapter|helpers)/")
        file(CHMOD "${package}/${relative}" PERMISSIONS
            OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
    endif()
endforeach()
if("@CMAKE_SYSTEM_NAME@" STREQUAL "Darwin")
    set(macos_arguments --package "${package}" --configuration "$<CONFIG>")
    if(NOT "@CMAKE_OSX_DEPLOYMENT_TARGET@" STREQUAL "")
        list(APPEND macos_arguments --minimum-macos "@CMAKE_OSX_DEPLOYMENT_TARGET@")
    endif()
    foreach(copy IN LISTS copies)
        string(REPLACE "|" ";" pair "${copy}")
        list(GET pair 0 input)
        list(GET pair 1 relative)
        if(relative MATCHES "^(adapter|helpers)/")
            list(APPEND macos_arguments --input "${input}" "${relative}")
        endif()
    endforeach()
    foreach(relative IN LISTS executable_relatives)
        list(APPEND macos_arguments --executable "${relative}")
    endforeach()
    execute_process(COMMAND "@Python3_EXECUTABLE@" -B "@QWEN_MACOS_RUNTIME_DEPLOYER@"
        ${macos_arguments} COMMAND_ERROR_IS_FATAL ANY)
endif()
if("@CMAKE_SYSTEM_NAME@" STREQUAL "Linux")
    foreach(relative IN LISTS runtime_resources)
        execute_process(COMMAND "@QWEN_PATCHELF_EXECUTABLE@" --set-rpath "$ORIGIN" "${package}/${relative}"
            COMMAND_ERROR_IS_FATAL ANY)
    endforeach()
    foreach(relative IN LISTS executable_relatives)
        file(RPATH_CHANGE FILE "${package}/${relative}"
            OLD_RPATH "$ORIGIN:$<TARGET_FILE_DIR:Qt6::Core>" NEW_RPATH "$ORIGIN")
        list(APPEND linux_arguments --executable "${relative}")
    endforeach()
    if(NOT "@QWEN_RUNTIME_NOTICES_DIRECTORY@" STREQUAL "")
        list(APPEND linux_arguments --runtime-notices "@QWEN_RUNTIME_NOTICES_DIRECTORY@")
    endif()
    if(NOT "@QWEN_LINUX_RUNTIME_MATERIAL@" STREQUAL "")
        list(APPEND linux_arguments --prebuilt-material "@QWEN_LINUX_RUNTIME_MATERIAL@")
    endif()
    execute_process(COMMAND "@Python3_EXECUTABLE@" -B "@QWEN_LINUX_RUNTIME_DEPLOYER@"
        ${linux_arguments} COMMAND_ERROR_IS_FATAL ANY)
endif()
file(WRITE "${package}/notices/runtime.txt" "${notice_text}")
file(WRITE "${package}/provenance/runtime.txt"
    "Qt @Qt6Core_VERSION@: https://code.qt.io/cgit/qt/qtbase.git/\nSelected qtbase notice source: @QWEN_QTBASE_SOURCE@\nResolved executable closure:\n${runtime_provenance}")
set(index_arguments
    --third-party assets/qwen_dark.svg notices/qwen-LICENSE.txt provenance/qwen_logo.json
    --third-party assets/qwen_light.svg notices/qwen-LICENSE.txt provenance/qwen_logo.json)
foreach(relative IN LISTS runtime_resources)
    if("@CMAKE_SYSTEM_NAME@" STREQUAL "Linux")
        list(APPEND index_arguments --third-party "${relative}" notices/runtime.txt provenance/linux-runtime.json)
    else()
        list(APPEND index_arguments --third-party "${relative}" notices/runtime.txt provenance/runtime.txt)
    endif()
endforeach()
set(index_command [==[@qwen_package_indexer@]==])
execute_process(COMMAND ${index_command} "${package}" ${index_arguments}
    COMMAND_ERROR_IS_FATAL ANY)
qwen_package_content_signature(package_signature)
file(WRITE "${receipt}" "${signature}\n${package_signature}\n")
