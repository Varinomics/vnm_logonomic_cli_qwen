cmake_minimum_required(VERSION 3.25)
set(package "@QWEN_PACKAGE_DIRECTORY@")
set(CMAKE_GET_RUNTIME_DEPENDENCIES_PLATFORM macos+macho)
set(CMAKE_GET_RUNTIME_DEPENDENCIES_TOOL otool)
set(CMAKE_GET_RUNTIME_DEPENDENCIES_COMMAND /usr/bin/otool)

file(READ "${package}/package.files.json" index)
file(READ "${package}/provenance/macos-runtime.json" report)
string(JSON count LENGTH "${report}" files)
if(count LESS 4)
    message(FATAL_ERROR "The actual package has no complete native runtime report.")
endif()
math(EXPR last "${count} - 1")
foreach(entry RANGE 0 ${last})
    string(JSON relative GET "${report}" files ${entry} path)
    string(JSON expected GET "${report}" files ${entry} sha256)
    if(IS_SYMLINK "${package}/${relative}" OR NOT EXISTS "${package}/${relative}")
        message(FATAL_ERROR "Native package member is not a regular file: ${relative}")
    endif()
    file(SHA256 "${package}/${relative}" actual)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "Native runtime differs from its deployment report: ${relative}")
    endif()
endforeach()

foreach(executable IN ITEMS
        adapter/qwen_adapter helpers/qwen_helper helpers/qwen_launch_bridge)
    file(GET_RUNTIME_DEPENDENCIES EXECUTABLES "${package}/${executable}"
        PRE_EXCLUDE_REGEXES "^/System/Library/" "^/usr/lib/"
        RESOLVED_DEPENDENCIES_VAR resolved UNRESOLVED_DEPENDENCIES_VAR unresolved
        CONFLICTING_DEPENDENCIES_PREFIX conflicts)
    if(unresolved OR conflicts_FILENAMES)
        message(FATAL_ERROR "Incomplete staged native closure for ${executable}: ${unresolved}; ${conflicts_FILENAMES}")
    endif()
    foreach(runtime IN LISTS resolved)
        file(REAL_PATH "${runtime}" native_path)
        cmake_path(IS_PREFIX package "${native_path}" NORMALIZE contained)
        if(NOT contained OR IS_SYMLINK "${runtime}")
            message(FATAL_ERROR "Native runtime escapes the package: ${runtime}")
        endif()
        file(RELATIVE_PATH relative "${package}" "${runtime}")
        file(SHA256 "${runtime}" expected)
        string(JSON index_count LENGTH "${index}" files)
        math(EXPR last_index "${index_count} - 1")
        set(found FALSE)
        foreach(index_entry RANGE 0 ${last_index})
            string(JSON indexed_path GET "${index}" files ${index_entry} path)
            if(indexed_path STREQUAL relative)
                string(JSON actual GET "${index}" files ${index_entry} sha256)
                string(JSON origin GET "${index}" files ${index_entry} resource origin)
                string(JSON notice GET "${index}" files ${index_entry} resource notice)
                string(JSON provenance GET "${index}" files ${index_entry} resource provenance)
                if(NOT actual STREQUAL expected OR NOT origin STREQUAL "third-party" OR
                   NOT notice STREQUAL "notices/runtime.txt" OR
                   NOT provenance STREQUAL "provenance/runtime.txt")
                    message(FATAL_ERROR "Native runtime integrity or attribution differs: ${relative}")
                endif()
                set(found TRUE)
                break()
            endif()
        endforeach()
        if(NOT found)
            message(FATAL_ERROR "Native runtime is absent from the integrity index: ${relative}")
        endif()
    endforeach()
endforeach()
message(STATUS "Actual packaged Mach-O runtime closure and indexed bytes verified.")
