include_guard(GLOBAL)

set(qwen_runtime_system_directories "")
if(CMAKE_HOST_WIN32 AND CMAKE_GET_RUNTIME_DEPENDENCIES_PLATFORM STREQUAL "windows+pe")
    # Match the native Windows directories used by CMake's PE resolver. The
    # system PowerShell follows the invoking process's filesystem redirection.
    set(system_powershell "$ENV{SystemRoot}/System32/WindowsPowerShell/v1.0/powershell.exe")
    if(EXISTS "${system_powershell}")
        execute_process(COMMAND "${system_powershell}" -NoProfile -NonInteractive -Command
            "[Environment]::GetFolderPath('System'); [Environment]::GetFolderPath('Windows')"
            RESULT_VARIABLE directories_result OUTPUT_VARIABLE directories
            ERROR_QUIET OUTPUT_STRIP_TRAILING_WHITESPACE)
        if(directories_result EQUAL 0 AND directories)
            string(REPLACE "\r" "" directories "${directories}")
            string(REPLACE "\\" "/" directories "${directories}")
            string(REPLACE "\n" ";" qwen_runtime_system_directories "${directories}")
        endif()
    endif()
endif()

function(qwen_runtime_dependency_signature output binary dependencies)
    set(signature "${CMAKE_VERSION}\n${CMAKE_GET_RUNTIME_DEPENDENCIES_PLATFORM}\n"
        "${CMAKE_GET_RUNTIME_DEPENDENCIES_TOOL}\n${runtime_search_dirs}\n${exclusions}\n")
    set(directories ${runtime_search_dirs} ${qwen_runtime_system_directories})
    set(files "${binary}" ${dependencies} "${CMAKE_COMMAND}"
        "${CMAKE_GET_RUNTIME_DEPENDENCIES_COMMAND}" "${CMAKE_CURRENT_FUNCTION_LIST_FILE}")
    list(REMOVE_DUPLICATES files)
    foreach(path IN LISTS files)
        if(NOT EXISTS "${path}" OR IS_DIRECTORY "${path}")
            set(${output} "" PARENT_SCOPE)
            return()
        endif()
        file(REAL_PATH "${path}" actual_path)
        string(SHA256 file_key "${actual_path}")
        get_property(has_digest GLOBAL PROPERTY "QWEN_RUNTIME_DIGEST_${file_key}" SET)
        if(has_digest)
            get_property(digest GLOBAL PROPERTY "QWEN_RUNTIME_DIGEST_${file_key}")
        else()
            file(SHA256 "${path}" digest)
            set_property(GLOBAL PROPERTY "QWEN_RUNTIME_DIGEST_${file_key}" "${digest}")
        endif()
        string(APPEND signature "${path}|${actual_path}|${digest}\n")
        get_filename_component(directory "${actual_path}" DIRECTORY)
        list(APPEND directories "${directory}")
        get_filename_component(directory "${path}" DIRECTORY)
        list(APPEND directories "${directory}")
    endforeach()
    list(REMOVE_DUPLICATES directories)
    foreach(directory IN LISTS directories)
        file(REAL_PATH "${directory}" actual_directory)
        string(SHA256 directory_key "${directory}|${actual_directory}")
        get_property(has_members GLOBAL PROPERTY "QWEN_RUNTIME_MEMBERS_${directory_key}" SET)
        if(has_members)
            get_property(members GLOBAL PROPERTY "QWEN_RUNTIME_MEMBERS_${directory_key}")
        else()
            file(GLOB members LIST_DIRECTORIES FALSE RELATIVE "${directory}" "${directory}/*")
            set_property(GLOBAL PROPERTY "QWEN_RUNTIME_MEMBERS_${directory_key}" "${members}")
        endif()
        # New files can take precedence over a previously resolved DLL. Hashing
        # only that old DLL would preserve an obsolete resolution indefinitely.
        string(APPEND signature "${directory}|${actual_directory}|${members}\n")
    endforeach()
    string(SHA256 signature "${signature}")
    set(${output} "${signature}" PARENT_SCOPE)
endfunction()

function(qwen_resolve_runtime_dependencies output kind binary)
    string(SHA256 key "${kind}|${binary}|${runtime_search_dirs}|${exclusions}")
    get_property(has_resolution GLOBAL PROPERTY "QWEN_RUNTIME_RESOLVED_${key}" SET)
    if(has_resolution)
        get_property(resolved GLOBAL PROPERTY "QWEN_RUNTIME_RESOLVED_${key}")
        set(${output} "${resolved}" PARENT_SCOPE)
        return()
    endif()
    set(cache "")
    if(qwen_runtime_system_directories)
        file(MAKE_DIRECTORY "${qwen_runtime_dependency_cache_directory}")
        set(cache "${qwen_runtime_dependency_cache_directory}/${key}.json")
        if(EXISTS "${cache}")
            file(READ "${cache}" record)
            string(JSON previous ERROR_VARIABLE invalid GET "${record}" signature)
            if(NOT invalid)
                string(JSON resolved ERROR_VARIABLE invalid GET "${record}" resolved)
                if(NOT invalid)
                    qwen_runtime_dependency_signature(signature "${binary}" "${resolved}")
                    if(signature AND signature STREQUAL previous)
                        set_property(GLOBAL PROPERTY "QWEN_RUNTIME_RESOLVED_${key}" "${resolved}")
                        set(${output} "${resolved}" PARENT_SCOPE)
                        return()
                    endif()
                endif()
            endif()
        endif()
    endif()

    file(GET_RUNTIME_DEPENDENCIES ${kind} "${binary}"
        DIRECTORIES ${runtime_search_dirs} ${exclusions}
        RESOLVED_DEPENDENCIES_VAR resolved UNRESOLVED_DEPENDENCIES_VAR unresolved
        CONFLICTING_DEPENDENCIES_PREFIX conflicts)
    if(unresolved OR conflicts_FILENAMES)
        message(FATAL_ERROR
            "Incomplete runtime closure for ${binary}: unresolved=${unresolved}; conflicts=${conflicts_FILENAMES}")
    endif()
    if(cache)
        qwen_runtime_dependency_signature(signature "${binary}" "${resolved}")
        if(signature)
            string(REPLACE "\\" "\\\\" escaped "${resolved}")
            string(REPLACE "\"" "\\\"" escaped "${escaped}")
            string(JSON record SET "{}" signature "\"${signature}\"")
            string(JSON record SET "${record}" resolved "\"${escaped}\"")
            string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef token)
            file(WRITE "${cache}.${token}" "${record}\n")
            file(RENAME "${cache}.${token}" "${cache}")
        endif()
    endif()
    set_property(GLOBAL PROPERTY "QWEN_RUNTIME_RESOLVED_${key}" "${resolved}")
    set(${output} "${resolved}" PARENT_SCOPE)
endfunction()
