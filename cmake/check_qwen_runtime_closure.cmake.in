cmake_minimum_required(VERSION 3.25)
set(package "@QWEN_PACKAGE_DIRECTORY@")
set(source "@CMAKE_CURRENT_SOURCE_DIR@")
set(compiler_runtimes "@qwen_compiler_runtime_files@")
set(debug_compiler_runtimes "@qwen_debug_runtime_files@")
set(CMAKE_GET_RUNTIME_DEPENDENCIES_PLATFORM windows+pe)
set(CMAKE_GET_RUNTIME_DEPENDENCIES_TOOL dumpbin)
get_filename_component(compiler_dir "@CMAKE_CXX_COMPILER@" DIRECTORY)
set(CMAKE_GET_RUNTIME_DEPENDENCIES_COMMAND "${compiler_dir}/dumpbin.exe")

file(READ "${package}/package.files.json" index)
file(READ "${package}/notices/runtime.txt" notices)
file(READ "${package}/provenance/runtime.txt" provenance)
string(JSON entry_count LENGTH "${index}" files)
math(EXPR last_entry "${entry_count} - 1")
file(GLOB executables "${package}/adapter/*.exe" "${package}/helpers/*.exe")
if(NOT executables)
    message(FATAL_ERROR "The actual package contains no executables to inspect.")
endif()

set(compiler_runtime_count 0)
set(debug_crt_count 0)
set(debug_ucrt_count 0)
foreach(executable IN LISTS executables)
    get_filename_component(directory "${executable}" DIRECTORY)
    file(RELATIVE_PATH package_directory "${package}" "${directory}")
    file(GET_RUNTIME_DEPENDENCIES EXECUTABLES "${executable}"
        DIRECTORIES "${directory}"
        PRE_EXCLUDE_REGEXES "^[Aa][Pp][Ii]-" "^[Ee][Xx][Tt]-"
        POST_INCLUDE_REGEXES ".*/[Mm][Ss][Vv][Cc][Pp][0-9].*" ".*/[Vv][Cc][Rr][Uu][Nn][Tt][Ii][Mm][Ee].*"
            ".*/[Cc][Oo][Nn][Cc][Rr][Tt][0-9].*" ".*/[Vv][Cc][Cc][Oo][Rr][Ll][Ii][Bb][0-9].*"
            ".*/[Uu][Cc][Rr][Tt][Bb][Aa][Ss][Ee][Dd]\\.[Dd][Ll][Ll]$"
        POST_EXCLUDE_REGEXES ".*[/\\\\][Ww][Ii][Nn][Dd][Oo][Ww][Ss][/\\\\].*"
        RESOLVED_DEPENDENCIES_VAR resolved UNRESOLVED_DEPENDENCIES_VAR unresolved
        CONFLICTING_DEPENDENCIES_PREFIX conflicts)
    if(unresolved OR conflicts_FILENAMES)
        message(FATAL_ERROR "The actual packaged executable has an incomplete runtime closure: ${executable}")
    endif()
    foreach(runtime IN LISTS resolved)
        get_filename_component(runtime_name "${runtime}" NAME)
        string(TOLOWER "${runtime_name}" runtime_lower)
        # These public Windows runtime families must be package-local. The
        # release UCRT belongs to the supported OS; Debug UCRT does not.
        if(NOT runtime_lower MATCHES "^(msvcp[0-9]|vcruntime[0-9]|concrt[0-9]|vccorlib[0-9]|ucrtbased\\.dll)")
            continue()
        endif()
        set(selected_runtime "")
        foreach(candidate IN LISTS compiler_runtimes debug_compiler_runtimes)
            get_filename_component(candidate_name "${candidate}" NAME)
            string(TOLOWER "${candidate_name}" candidate_lower)
            if(candidate_lower STREQUAL runtime_lower)
                set(selected_runtime "${candidate}")
                break()
            endif()
        endforeach()
        if(NOT selected_runtime)
            message(FATAL_ERROR "Runtime ${runtime_name} has no selected compiler/SDK source.")
        endif()
        set(relative "${package_directory}/${runtime_name}")
        if(NOT EXISTS "${package}/${relative}")
            message(FATAL_ERROR "Runtime ${relative} is absent from the actual package.")
        endif()
        file(SHA256 "${selected_runtime}" expected_digest)
        file(SHA256 "${package}/${relative}" packaged_digest)
        if(NOT expected_digest STREQUAL packaged_digest)
            message(FATAL_ERROR "Runtime ${relative} differs from the selected compiler/SDK bytes.")
        endif()
        set(indexed FALSE)
        foreach(entry RANGE 0 ${last_entry})
            string(JSON entry_path GET "${index}" files ${entry} path)
            if(entry_path STREQUAL relative)
                string(JSON digest GET "${index}" files ${entry} sha256)
                string(JSON origin GET "${index}" files ${entry} resource origin)
                string(JSON notice GET "${index}" files ${entry} resource notice)
                string(JSON record GET "${index}" files ${entry} resource provenance)
                if(NOT digest STREQUAL packaged_digest OR NOT origin STREQUAL "third-party" OR
                        NOT notice STREQUAL "notices/runtime.txt" OR NOT record STREQUAL "provenance/runtime.txt")
                    message(FATAL_ERROR "Runtime ${relative} has incorrect integrity/attribution metadata.")
                endif()
                set(indexed TRUE)
            endif()
        endforeach()
        if(NOT indexed)
            message(FATAL_ERROR "Runtime ${relative} is absent from the integrity index.")
        endif()
        string(FIND "${provenance}" "${relative} <- ${selected_runtime}" provenance_offset)
        if(provenance_offset LESS 0)
            message(FATAL_ERROR "Runtime ${relative} has no exact selected-source provenance.")
        endif()
        set(notice_file "${source}/package/notices/msvc-runtime.txt")
        if(selected_runtime IN_LIST debug_compiler_runtimes)
            set(notice_file "${source}/package/notices/msvc-debug-runtime.txt")
            if(runtime_lower STREQUAL "ucrtbased.dll")
                math(EXPR debug_ucrt_count "${debug_ucrt_count} + 1")
            else()
                math(EXPR debug_crt_count "${debug_crt_count} + 1")
            endif()
        endif()
        file(READ "${notice_file}" expected_notice)
        string(FIND "${notices}" "${expected_notice}" notice_offset)
        if(notice_offset LESS 0)
            message(FATAL_ERROR "Runtime ${relative} has no appropriate maintained runtime notice.")
        endif()
        math(EXPR compiler_runtime_count "${compiler_runtime_count} + 1")
    endforeach()
endforeach()
if(compiler_runtime_count EQUAL 0)
    message(FATAL_ERROR "The runtime attribution check did not inspect any compiler runtimes.")
endif()
if("$<CONFIG>" STREQUAL "Debug" AND (debug_crt_count EQUAL 0 OR debug_ucrt_count EQUAL 0))
    message(FATAL_ERROR "The Debug executable closure did not include both Debug CRT and Debug UCRT.")
endif()
if(NOT "$<CONFIG>" STREQUAL "Debug" AND (debug_crt_count GREATER 0 OR debug_ucrt_count GREATER 0))
    message(FATAL_ERROR "A release package unexpectedly contains Debug compiler runtimes.")
endif()
message(STATUS "Actual packaged runtime closure verified: ${compiler_runtime_count} compiler runtimes, ${debug_crt_count} Debug CRT and ${debug_ucrt_count} Debug UCRT dependencies.")
