cmake_minimum_required(VERSION 3.25)

file(READ "${PACKAGE}/package.files.json" index)
string(JSON entry_count LENGTH "${index}" files)
math(EXPR last_entry "${entry_count} - 1")
set(programs adapter/qwen_adapter adapter/qwen_helper adapter/qwen_launch_bridge)
set(runtime_names "")
set(qt_core_found FALSE)
foreach(entry RANGE 0 ${last_entry})
    string(JSON relative GET "${index}" files ${entry} path)
    string(JSON kind GET "${index}" files ${entry} resource kind)
    foreach(program IN LISTS programs)
        if(relative STREQUAL "${program}${EXECUTABLE_SUFFIX}")
            if(NOT kind STREQUAL "executable")
                message(FATAL_ERROR "Packaged program has incorrect resource classification: ${relative}")
            endif()
            list(REMOVE_ITEM programs "${program}")
        endif()
    endforeach()
    string(JSON provenance ERROR_VARIABLE missing GET "${index}" files ${entry} resource provenance)
    if(NOT missing AND provenance MATCHES "^provenance/(runtime\\.txt|linux-runtime\\.json)$" AND
       relative MATCHES "^(adapter|helpers)/")
        get_filename_component(name "${relative}" NAME)
        string(TOLOWER "${name}" runtime_name)
        if(runtime_name IN_LIST runtime_names)
            message(FATAL_ERROR "Packaged programs do not share their runtime library: ${name}")
        endif()
        if(name MATCHES "^(lib)?Qt6Core" OR name STREQUAL "QtCore")
            set(qt_core_found TRUE)
        endif()
        list(APPEND runtime_names "${runtime_name}")
    endif()
endforeach()
if(EXISTS "${PACKAGE}/provenance/linux-runtime.json")
    file(READ "${PACKAGE}/provenance/linux-runtime.json" runtime_report)
    string(JSON observation_count LENGTH "${runtime_report}" files)
    math(EXPR last_observation "${observation_count} - 1")
    set(controlled "")
    set(supplied "")
    foreach(observation RANGE 0 ${last_observation})
        string(JSON relative GET "${runtime_report}" files ${observation} path)
        string(JSON owner GET "${runtime_report}" files ${observation} owner)
        string(JSON expected GET "${runtime_report}" files ${observation} sha256)
        file(SHA256 "${PACKAGE}/${relative}" actual)
        if(NOT actual STREQUAL expected)
            message(FATAL_ERROR "Linux runtime provenance differs from packaged bytes: ${relative}")
        endif()
        if(owner STREQUAL "controlled")
            list(APPEND controlled "${relative}")
        elseif(owner STREQUAL "supplied-runtime")
            get_filename_component(name "${relative}" NAME)
            string(TOLOWER "${name}" runtime_name)
            list(APPEND supplied "${runtime_name}")
        else()
            message(FATAL_ERROR "Unknown Linux runtime owner: ${relative}: ${owner}")
        endif()
    endforeach()
    list(SORT controlled)
    list(SORT supplied)
    set(expected_controlled adapter/qwen_adapter adapter/qwen_helper adapter/qwen_launch_bridge)
    list(SORT runtime_names)
    if(NOT controlled STREQUAL expected_controlled OR NOT supplied STREQUAL runtime_names)
        message(FATAL_ERROR "Linux provenance does not describe the programs and their indexed runtime closure.")
    endif()
endif()
if(programs OR NOT runtime_names OR NOT qt_core_found)
    message(FATAL_ERROR "Package is missing programs or their QtCore runtime closure: ${programs}")
endif()
message(STATUS "All three packaged programs share one indexed runtime closure.")
